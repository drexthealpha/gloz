# Gloz backend settings. Copy to .env and fill in only the services you use.
# Keys stay on the backend; the glasses app never sees them.

PORT=8787
# GLOZ_PAIR_CODE=123456          # optional; a random code is printed at start when empty

# AI drafts (any one is enough; the first that answers is used)
GLOZ_OPENROUTER_KEY=
GLOZ_OPENROUTER_MODEL=openrouter/auto
GLOZ_ANTHROPIC_KEY=
GLOZ_OPENAI_KEY=

# Telegram: a bot from @BotFather; chat ids to read (empty = every chat the bot is in)
GLOZ_TELEGRAM_BOT_TOKEN=
GLOZ_TELEGRAM_CHATS=

# Telegram account (every chat you have, not only a bot's): API id and hash from
# my.telegram.org, then run `node --env-file=.env server/telegram-login.mjs` once
GLOZ_TELEGRAM_API_ID=
GLOZ_TELEGRAM_API_HASH=
GLOZ_TELEGRAM_SESSION=

# Slack: a user token (xoxp-...) with channels:history, chat:write, users:read; channel ids
GLOZ_SLACK_TOKEN=
GLOZ_SLACK_CHANNELS=

# Discord: a bot token with Read Message History and Send Messages; channel ids
GLOZ_DISCORD_BOT_TOKEN=
GLOZ_DISCORD_CHANNELS=

# Gmail: run `node server/google-auth.mjs` once to get the refresh token
GLOZ_GOOGLE_CLIENT_ID=
GLOZ_GOOGLE_CLIENT_SECRET=
GLOZ_GOOGLE_REFRESH_TOKEN=

# Speech to text on this server: `npm install @huggingface/transformers` (Whisper runs here),
# or set GLOZ_OPENAI_KEY above.
# GLOZ_WHISPER_MODEL=onnx-community/whisper-base_timestamped

# Apps on the glasses (all optional; each app says on the glasses what it needs)
GLOZ_NOTION_TOKEN=
GLOZ_NOTION_NOTES_DB=
GLOZ_NOTION_TASKS_DB=
GLOZ_FINNHUB_KEY=
GLOZ_STOCKS=AAPL,MSFT,NVDA
# Weather (Open-Meteo, no key) uses the phone's position; without one, this place ("lat,lon").
# GLOZ_WEATHER_AT=51.507,-0.128
# News: any RSS or Atom feed (default: BBC News world headlines).
# GLOZ_NEWS_FEED=https://feeds.bbci.co.uk/news/world/rss.xml
# "How does example.com's search work?" in Ask reads the site's code; with rea installed
# (npm install -g rea-agents, MIT), its JavaScript analysis is added to the evidence.
GLOZ_SPOTIFY_CLIENT_ID=
GLOZ_SPOTIFY_CLIENT_SECRET=
GLOZ_SPOTIFY_REFRESH_TOKEN=
# Terminal runs only these command names on this server, and only when GLOZ_TERMINAL=1
GLOZ_TERMINAL=
GLOZ_TERMINAL_ALLOW=
# A routing server with walking and cycling profiles (the public demo server routes cars only)
GLOZ_OSRM_URL=
